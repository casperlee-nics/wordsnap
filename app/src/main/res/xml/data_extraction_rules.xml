<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以後：雲端備份（Google 備份）和換機傳輸（例如三星 Smart Switch）都帶走存檔和遊戲設定 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
